{
  "name": "gen1-map-porter",
  "version": "0.1.1",
  "private": true,
  "description": "Ports Red, Blue and Yellow maps, with their events, into a Crystal project: CrystalShireEngine, pokecrystal or Polished Crystal.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "build": "npm run build:node && npm run build:web",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server/index.js",
    "package": "npm run build && node scripts/package.mjs",
    "cli": "node dist/cli/index.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
